# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user-provided message exports (can be 10GB+, always PII)
sms-*.xml
chat.db
*.db-journal
*.db-wal
*.db-shm

# user-provided contacts exports (PII: names, phone numbers, photos)
*.vcf
*.abcddb
*.abcddb-*
*.aclcddb
*.aclcddb-*
AddressBook/

# local sample / scratch data
imessage_sample/

# legacy (moved Next.js was here)
nextjs/
